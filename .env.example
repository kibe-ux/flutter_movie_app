# Copy this file to ".env" and replace the placeholders with real values

# TMDB API key (you supplied one above)
MOVIE_API_KEY=your_tmdb_api_key_here

# Movie download backend API
MOVIE_DOWNLOAD_API_BASE_URL=http://10.0.2.2:3000

# FILMS365_API_KEY is server-side only; configure it in backend/.env or in the
# backend deployment environment. Never add it to this Flutter .env asset.

# Google test ads now. Later, set the flag false and replace ALL THREE ad units
# with your publisher IDs for the target platform, then rebuild in release mode.
# Also replace native Android/iOS AdMob app IDs before publishing live ads.
ADMOB_USE_TEST_ADS=true
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
