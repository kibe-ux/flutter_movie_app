PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
FIREBASE_PROJECT_ID=your_firebase_project_id
# Configure application-default credentials on the server; do not commit a service-account key.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Hosted Neon runtime: provide this through the private deployment environment,
# never in the mobile app, browser config, source control, or command arguments.
# FIREBASE_SERVICE_ACCOUNT_JSON=
WAMBESHA_API_KEY=your_wambesha_api_key
# Shared per-minute Wambesha budgets: requests/user, new source checks/user, upstream/global.
WAMBESHA_CLIENT_LIMIT=60
WAMBESHA_SOURCE_LIMIT=8
WAMBESHA_UPSTREAM_LIMIT=120
# Keep false until cross-user and cross-instance signed-link reuse is verified.
WAMBESHA_SHARED_SOURCES=false
TMDB_API_KEY=your_tmdb_api_key
# Requests per minute, shared across API instances.
CATALOGUE_CLIENT_LIMIT=120
CATALOGUE_UPSTREAM_LIMIT=600

# Keep rewards disabled until the SSV callback and database access are verified.
ADMOB_REWARDS_ENABLED=false
# Comma-separated full publisher rewarded ad unit IDs (Android and/or iOS).
ADMOB_REWARDED_UNIT_IDS=

# Neon PostgreSQL connection string (server-side only).
# Copy it from your Neon project's Connect dialog; never put it in Flutter .env.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_ENDPOINT.neon.tech/neondb?sslmode=require&channel_binding=require
# Enable only after the Firestore write fence and scheduled retry worker are deployed.
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_WORKER_ENABLED=false
