{
  "name": "movie-download-backend",
  "version": "1.0.0",
  "description": "Secure movie download backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "load:test": "node load/run.js",
    "accounts:retry-deletions": "node scripts/retry_account_deletions.js",
    "db:check": "node scripts/check_neon_database.js",
    "neon:build": "node scripts/deploy_neon.js --build",
    "neon:plan": "node scripts/deploy_neon.js --plan",
    "neon:deploy": "node scripts/deploy_neon.js --deploy",
    "neon:status": "node scripts/deploy_neon.js --status",
    "catalogue:plan": "node scripts/deploy_neon.js --plan --catalogue-only",
    "catalogue:deploy": "node scripts/deploy_neon.js --deploy --catalogue-only"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.0",
    "mime": "^3.0.0",
    "serverless-http": "^4.0.0"
  },
  "overrides": {
    "qs": "^6.17.1",
    "rimraf": "^6.1.4"
  },
  "devDependencies": {
    "@neon/config": "^1.9.3",
    "esbuild": "^0.28.2",
    "neon": "^8.11.1"
  }
