{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Movie Hub (Ad Inspector)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define=ADMOB_TEST_DEVICE_IDS=${input:admobTestDeviceId}",
                "--dart-define=ADMOB_OPEN_AD_INSPECTOR=true"
            ]
        },
    
        {
            "name": "flutter_application_1",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "flutter_application_1 (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flutter_application_1 (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "movie_app",
            "cwd": "movie_app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "movie_app (profile mode)",
            "cwd": "movie_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "movie_app (release mode)",
            "cwd": "movie_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ],
    "inputs": [
        {
            "id": "admobTestDeviceId",
            "type": "promptString",
            "description": "AdMob test device ID from the phone's Google Ads log",
            "default": "E08F4094730EE05B7BBEE9DE918C6CE1"
        }
    ]
}
